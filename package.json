{
  "name": "dachoupai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run tests/domain.test.ts tests/SeededRng.test.ts",
    "test:domain:browser": "node harness/domain.mjs",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "shot": "node harness/screenshot.mjs",
    "verify:smoke": "node harness/screenshot.mjs --verify-smoke",
    "release:checked": "node scripts/release-checked.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
